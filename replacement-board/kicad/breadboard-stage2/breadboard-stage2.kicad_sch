	(text "C4 (470-1000u, 10 V+, + to 5V) right at the ESP32's 5V/GND pins covers\nWi-Fi start-up bursts; without it the board resets while joining Wi-Fi.\n5V pin is fed by the MP1584. Unplug USB while powered this way\nunless your board has a diode between VBUS and 5V.\nESP32 GND is tied to the module's COMMON through J1 pin 2.\nPins match firmware/breadboard_test (TX 25, AUX 34, VRES 35)."
		(exclude_from_sim no)
		(at 25.4 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8a2a0799-6e63-43d3-995c-92186df998f5")
	)
